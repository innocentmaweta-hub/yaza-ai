# Add at least one provider key in your Vercel project settings.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
KIMI_API_KEY=

# Optional model defaults
# Optional OpenAI model override; GPT-6.2 models can also be selected in Yaza.
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=openrouter/free
KIMI_MODEL=moonshot-v1-8k
# Supabase project settings
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web search (Tavily). Keep this key server-side; never use a VITE_ prefix.
TAVILY_API_KEY=

# Optional OpenRouter image model (uses OPENROUTER_API_KEY and paid image-generation credits)
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5

# Yaza admin dashboard (server-only; NEVER use a VITE_ prefix for the service role key)
SUPABASE_SERVICE_ROLE_KEY=
YAZA_ADMIN_EMAIL=

# Server-side AI request quotas (optional; defaults shown)
YAZA_DAILY_REQUEST_LIMIT=50
YAZA_MONTHLY_REQUEST_LIMIT=1000
YAZA_GUEST_DAILY_REQUEST_LIMIT=10

# PayChangu wallet payments (server-only; never use a VITE_ prefix)
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
APP_URL=https://yaza-ai.vercel.app

# Optional direct Claude provider
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Optional direct DeepSeek provider
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional per-account web-search quotas (UTC periods)
YAZA_SEARCH_DAILY_LIMIT=20
YAZA_SEARCH_MONTHLY_LIMIT=300
