# Add at least one provider key in your Vercel project settings.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
KIMI_API_KEY=

# Optional model defaults
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.5-flash
KIMI_MODEL=moonshot-v1-8k
# Supabase project settings
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web search (Tavily). Keep this key server-side; never use a VITE_ prefix.
TAVILY_API_KEY=

# Optional OpenRouter image model (uses OPENROUTER_API_KEY and paid image-generation credits)
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5

# Yaza admin dashboard (server-only; NEVER use a VITE_ prefix for the service role key)
SUPABASE_SERVICE_ROLE_KEY=
YAZA_ADMIN_EMAIL=
